# Shared local development settings. Copy to .env.local and adjust as needed.
# Do not commit real API keys or long-lived tokens.
CHAT_SERVER_HOST=127.0.0.1
CHAT_SERVER_PORT=14317
# CHAT_SERVER_TOKEN=replace-with-a-local-token

# Optional: keep development data outside the repository.
# CHAT_SERVER_DATA_DIR=/absolute/path/to/chatdesk-data

# Optional sidecar/browser settings. `pnpm dev` points the Chat Server at the
# source browser-worker.mjs; override only when using a custom worker.
# M_DASHBOARD_SKIP_BROWSER_DOWNLOAD=1
# CHAT_SERVER_BROWSER_WORKER=/absolute/path/to/browser-worker
# CHAT_SERVER_PLAYWRIGHT_BROWSERS_PATH=/absolute/path/to/playwright-browsers
