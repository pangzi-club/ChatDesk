{
  "name": "chatdesk-tauri",
  "private": true,
  "version": "0.4.0",
  "description": "Tauri fallback host for ChatDesk",
  "license": "MIT",
  "repository": "https://github.com/pangzi-club/ChatDesk",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "exports": {
    "./renderer": "./src/renderer-bridge.ts"
  },
  "scripts": {
    "dev": "tauri dev",
    "desktop:dev": "tauri dev",
    "desktop:sidecars": "node ../../scripts/build-sidecars.mjs",
    "desktop:sidecars:verify": "node ../../scripts/verify-browser-worker.mjs",
    "desktop:package:verify": "node ../../scripts/verify-browser-worker.mjs --app",
    "desktop:build": "pnpm desktop:sidecars && tauri build"
  },
  "dependencies": {
    "@chatdesk/shared": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
