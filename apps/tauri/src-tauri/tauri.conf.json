{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatDesk",
  "version": "0.4.0",
  "identifier": "org.bohao.mdashboard",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. --filter chatdesk-desktop exec vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../.. build:web",
    "frontendDist": "../../desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChatDesk",
        "visible": false,
        "hiddenTitle": true,
        "width": 1280,
        "height": 720,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 16, "y": 16 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; base-uri 'self'; object-src 'none'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:1421 ws://localhost:1421 https:; frame-src http: https:; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$HOME/.chatdesk/**",
          "$DESKTOP/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["../../desktop/assets/binaries/node-runtime"],
    "resources": [
      "../../desktop/assets/resources/node-runtime/**/*",
      "../../desktop/assets/resources/playwright-browsers/**/*"
    ],
    "targets": "all",
    "icon": [
      "../../desktop/assets/icons/32x32.png",
      "../../desktop/assets/icons/128x128.png",
      "../../desktop/assets/icons/128x128@2x.png",
      "../../desktop/assets/icons/icon.icns",
      "../../desktop/assets/icons/icon.ico"
    ]
  }
}
