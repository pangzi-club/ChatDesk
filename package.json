{
  "name": "chatdesk-workspace",
  "private": true,
  "version": "0.2.0",
  "description": "ChatDesk workspace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pangzi-club/ChatDesk.git"
  },
  "bugs": {
    "url": "https://github.com/pangzi-club/ChatDesk/issues"
  },
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "desktop:dev": "pnpm --filter chatdesk-desktop desktop:dev",
    "dev:web": "pnpm --filter chatdesk-desktop dev",
    "dev:server": "pnpm server:dev",
    "migrate:chatdesk": "node scripts/migrate-to-chatdesk.mjs",
    "migrate:test": "node --test scripts/migrate-to-chatdesk.test.mjs",
    "server:dev": "node --watch --experimental-strip-types apps/server/src/server.ts",
    "server:test": "node --experimental-strip-types --test apps/server/src/*.test.ts",
    "shared:test": "pnpm --filter @chatdesk/shared test",
    "shared:typecheck": "pnpm --filter @chatdesk/shared typecheck",
    "chat-client:test": "pnpm --filter @chatdesk/chat-client test",
    "chat-client:typecheck": "pnpm --filter @chatdesk/chat-client typecheck",
    "build": "pnpm shared:typecheck && pnpm chat-client:typecheck && pnpm build:web && pnpm build:server",
    "build:web": "pnpm --filter chatdesk-desktop build",
    "build:server": "tsc -p tsconfig.server.json",
    "desktop:sidecars": "pnpm --filter chatdesk-desktop desktop:sidecars",
    "desktop:build": "pnpm --filter chatdesk-desktop desktop:build",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "preview": "pnpm --filter chatdesk-desktop preview"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "typescript": "6.0.3"
  }
}
