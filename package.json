{
  "name": "chatdesk-workspace",
  "private": true,
  "version": "0.5.0",
  "description": "ChatDesk workspace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pangzi-club/ChatDesk.git"
  },
  "bugs": {
    "url": "https://github.com/pangzi-club/ChatDesk/issues"
  },
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "dev:all": "node scripts/dev-electron.mjs",
    "desktop:dev": "node scripts/dev-electron.mjs",
    "dev:web": "pnpm --filter chatdesk-desktop dev",
    "dev:server": "pnpm server:dev",
    "migrate": "node scripts/migrate.mjs",
    "version:set": "node scripts/set-workspace-version.mjs",
    "server:dev": "node --watch --experimental-strip-types apps/server/src/server.ts",
    "test": "vitest run && node --test \"scripts/*.test.mjs\"",
    "server:test": "vitest run --project chatdesk-chat-server",
    "shared:test": "vitest run packages/shared/src",
    "shared:typecheck": "pnpm --filter @chatdesk/shared typecheck",
    "agent-core:test": "vitest run --project @chatdesk/agent-core",
    "agent-core:typecheck": "pnpm --filter @chatdesk/agent-core typecheck",
    "cli:test": "vitest run --project chatdesk-cli",
    "cli:typecheck": "pnpm --filter chatdesk-cli typecheck",
    "chatdesk": "node apps/cli/src/chatdesk.mjs",
    "chat-server-client:test": "vitest run packages/chat-server-client/src",
    "chat-server-client:typecheck": "pnpm --filter @chatdesk/chat-server-client typecheck",
    "desktop-host:test": "vitest run packages/desktop-host/src",
    "desktop-host:typecheck": "tsc -p packages/desktop-host/tsconfig.json",
    "desktop:typecheck": "pnpm --filter chatdesk-desktop typecheck",
    "electron:typecheck": "pnpm --filter chatdesk-electron typecheck",
    "typecheck": "pnpm -r --if-present typecheck",
    "electron:build": "pnpm --filter chatdesk-electron build",
    "electron:dev": "node scripts/dev-electron.mjs",
    "electron:package": "pnpm --filter chatdesk-electron package",
    "electron:package:verify": "pnpm --filter chatdesk-electron package:verify",
    "build": "pnpm shared:typecheck && pnpm agent-core:typecheck && pnpm chat-server-client:typecheck && pnpm desktop-host:typecheck && pnpm electron:typecheck && pnpm build:web && pnpm build:server",
    "build:web": "pnpm --filter chatdesk-desktop build",
    "build:server": "tsc -p tsconfig.server.json",
    "desktop:sidecars": "node scripts/build-sidecars.mjs",
    "desktop:sidecars:verify": "node scripts/verify-browser-worker.mjs",
    "desktop:build": "pnpm electron:package",
    "check": "biome check . && pnpm typecheck",
    "check:write": "biome check --write .",
    "format": "biome check --write .",
    "lint": "biome lint .",
    "preview": "pnpm --filter chatdesk-desktop preview"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
